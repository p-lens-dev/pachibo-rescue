{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pachibo-rescue",
  "version": "0.1.2",
  "identifier": "jp.p-lens.pachibo-rescue",
  "build": {
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ぱち簿のデータを取り出す", "width": 640, "height": 720, "minWidth": 360, "minHeight": 480 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "license": "GPL-3.0-or-later",
    "shortDescription": "ぱち簿のデータを iPhone のバックアップから取り出して、P-Lens で読み込める形にします",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installerHooks": "./windows/installer-hooks.nsh", "languages": ["Japanese"] } }
  }
}
